# Configurația notificărilor operaționale (ops/notify/notify.sh), DOAR pe host. Model pentru
# /srv/finet/env/notify.env (proprietar root, permisiuni 600), folosit cu
#   sudo sh ops/notify/notify.sh --env-file /srv/finet/env/notify.env --test
# Nu e dat niciunui container FINET (nu apare în docker-compose.yml), deci nu ajunge în
# config.v2.json. Valori FICTIVE. Canalul: Telegram SAU email (vezi notify.sh).

# secret
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# Email: cere SMTP_HOST, SMTP_FROM și NOTIFY_EMAIL_TO (port implicit 587).
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# secret
SMTP_PASSWORD=
SMTP_FROM=
