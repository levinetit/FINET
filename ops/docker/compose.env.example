# Variabilele de INTERPOLARE pentru ops/docker/docker-compose.yml (nu ajung în containere).
# Copie pe server: /srv/finet/compose/compose.env, folosită cu
#   docker compose -f ops/docker/docker-compose.yml --env-file /srv/finet/compose/compose.env ...
# Toate căile FINET stau în /srv/finet/, în afara backup-ului de /home (docs/INFRA.md).
# Valori FICTIVE; niciun secret aici.

# Hostname-ul public (folosit doar de varianta Traefik; obligatoriu pentru validarea fișierului).
FINET_HOST=finet.exemplu.invalid

# Imaginea construită local (`up -d --build`) sau trasă dintr-un registry ales de operator.
FINET_IMAGE=finet:local
# Imaginea de unelte (ținta `tools`: runner-ul de migrații), folosită de finet-migrate.
FINET_TOOLS_IMAGE=finet:tools

# Directorul cu fișierele de mediu, câte unul pe serviciu, permisiuni 600, în afara repo-ului:
#   finet.env (finet-web), finet.worker.env (finet-worker), finet.migrate.env (finet-migrate),
#   finet.admin.env (finet-admin).
# Modele: ops/docker/finet*.env.example.
FINET_ENV_DIR=/srv/finet/env

# Directorul de date pe host; conține `storage/` (deținut de uid 1000, mod 700).
FINET_DATA_DIR=/srv/finet

# IP-uri statice pe rețeaua `apps` (172.88.88.0/24). De confirmat de operator că sunt libere:
#   docker network inspect apps --format '{{range .Containers}}{{.IPv4Address}} {{.Name}}{{"\n"}}{{end}}'
FINET_WEB_IP=172.88.88.130
FINET_WORKER_IP=172.88.88.131

# Varianta Traefik: true doar dacă intrarea se face prin traefik-main în loc de cloudflare-tunnel.
FINET_TRAEFIK_ENABLE=false
# Numele certresolver-ului din /home/docker-apps/traefik/traefik.yml (de confirmat).
FINET_CERTRESOLVER=letsencrypt

# Secretele, câte un fișier (uid 1000, mod 400), montate în containere prin `secrets:`:
#   finet_database_url, finet_health_token, finet_better_auth_secret (finet-web;
#   finet_database_url și pentru finet-admin), finet_worker_database_url (finet-worker),
#   finet_migrate_database_url (finet-migrate). Directorul: root, mod 700.
FINET_SECRETS_DIR=/srv/finet/secrets

# CA-ul Supabase (public): directorul montat read-only în /run/finet/ca și numele fișierului.
FINET_CA_DIR=/srv/finet/ca
FINET_DATABASE_CA_NAME=prod-ca-2021.crt
