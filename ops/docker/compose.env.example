# Variabilele de INTERPOLARE pentru ops/docker/docker-compose.yml (nu ajung în containere).
# Copie pe server: /home/docker-apps/finet/compose.env, folosită cu
#   docker compose -f ops/docker/docker-compose.yml --env-file /home/docker-apps/finet/compose.env ...
# Valori FICTIVE; niciun secret aici.

# Hostname-ul public (folosit doar de varianta Traefik; obligatoriu pentru validarea fișierului).
FINET_HOST=finet.exemplu.invalid

# Imaginea construită local (`up -d --build`) sau trasă dintr-un registry ales de operator.
FINET_IMAGE=finet:local

# Mediul aplicației: fișier în afara repo-ului, permisiuni 600 (model: ops/docker/finet.env.example).
FINET_ENV_FILE=/home/docker-apps/finet/finet.env

# Directorul de date pe host; conține `storage/` (deținut de uid 1000, mod 700).
FINET_DATA_DIR=/home/docker-apps/finet

# IP-uri statice pe rețeaua `apps` (172.88.88.0/24). De confirmat de operator că sunt libere:
#   docker network inspect apps --format '{{range .Containers}}{{.IPv4Address}} {{.Name}}{{"\n"}}{{end}}'
FINET_WEB_IP=172.88.88.130
FINET_WORKER_IP=172.88.88.131

# Varianta Traefik: true doar dacă intrarea se face prin traefik-main în loc de cloudflare-tunnel.
FINET_TRAEFIK_ENABLE=false
# Numele certresolver-ului din /home/docker-apps/traefik/traefik.yml (de confirmat).
FINET_CERTRESOLVER=letsencrypt
