# Mediul serviciului finet-worker (FINET_ROLE=worker, profilul `worker`). Model pentru
# /srv/finet/env/finet.worker.env (proprietar root, permisiuni 600), citit de compose
# prin `env_file` DOAR pentru finet-worker. Valori FICTIVE.
# Workerul primește doar WORKER_DATABASE_URL: DATABASE_URL și MIGRATOR_DATABASE_URL îl opresc
# la pornire (src/lib/config.ts). În Faza 0 workerul e un stub care nu citește încă mediul.
#
# NU se setează aici (le fixează docker-compose.yml): FINET_ROLE=worker, NODE_ENV,
# APP_MODE=personal, STORAGE_DRIVER=local, STORAGE_DIR=/data/storage, NODE_OPTIONS.

# Pooler-ul Supabase în modul sesiune (5432), rolul finet_app (pg-boss cere sesiune).
# secret
WORKER_DATABASE_URL=postgres://finet_app.ref-exemplu:parola-exemplu@pooler.exemplu.invalid:5432/postgres?sslmode=verify-full

STORAGE_QUOTA_MB=5000

AI_DAILY_DOCUMENT_LIMIT=50
AI_MONTHLY_BUDGET=0
AI_MONTHLY_BUDGET_CURRENCY=USD
