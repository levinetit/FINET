# Mediul serviciului finet-web (FINET_ROLE=web) în producție (Docker pe docker-apps). Model
# pentru /srv/finet/env/finet.env (proprietar root, permisiuni 600), citit de compose
# prin `env_file` DOAR pentru finet-web. Valori FICTIVE: cele reale stau doar pe server.
# URL-urile workerului și migratorului NU se pun aici: stau în finet.worker.env și
# finet.migrate.env, iar serverul web refuză să pornească dacă le vede.
# Validarea: src/lib/config.ts. Lista completă și explicațiile: .env.example din rădăcina repo-ului.
#
# NU se setează aici (le fixează docker-compose.yml, care are prioritate): FINET_ROLE=web,
# NODE_ENV, APP_MODE=personal, CF_ACCESS_REQUIRED=true, STORAGE_DRIVER=local, STORAGE_DIR=/data/storage,
# HOSTNAME, PORT, NODE_OPTIONS.

APP_URL=https://finet.exemplu.invalid
NEXT_PUBLIC_APP_NAME=FINET

# Supabase (docs/GHID_CONSTRUIRE.md 4.4, ops/supabase/README.md). NU pune `sslrootcert=` în URL:
# postgres.js nu îl acceptă. CA-ul se montează în container (vezi docs/INFRA.md, „Supabase din container”).
# Pooler-ul Supabase în modul tranzacție (6543), rolul finet_app.
# secret
DATABASE_URL=postgres://finet_app.ref-exemplu:parola-exemplu@pooler.exemplu.invalid:6543/postgres?sslmode=verify-full

STORAGE_QUOTA_MB=5000

# Cloudflare Access (ops/cloudflare/README.md, pasul 4)
CF_ACCESS_TEAM_DOMAIN=echipa-exemplu.cloudflareaccess.com
CF_ACCESS_AUD=exemplu-aud-tag

# Opțional: /api/health detaliat din rețeaua internă, cu antetul X-Finet-Health-Token.
# Minimum 32 de caractere: openssl rand -hex 32
# secret
HEALTH_TOKEN=

AI_DAILY_DOCUMENT_LIMIT=50
AI_MONTHLY_BUDGET=0
AI_MONTHLY_BUDGET_CURRENCY=USD

# Notificări operaționale (ops/notify/notify.sh): Telegram SAU email.
# secret
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# Destinatarul alertelor pe email (folosit doar de ops/notify/notify.sh).
NOTIFY_EMAIL_TO=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# secret
SMTP_PASSWORD=
SMTP_FROM=
