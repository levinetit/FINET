# Configurația lui ops/backup/run-backup.sh pe HOST (nu intră în containere). Model pentru
# /srv/finet/env/backup-host.env (root, mod 600). Fără secrete. Valori de exemplu.

# Destinația: rclone (decizia operatorului: Google Drive, `rclone:Gdrive:finet-backup/restic`),
# s3, sftp sau local (local = doar test/interim, NU e în afara serverului).
FINET_BACKUP_DEST=rclone
# Fișierul de interpolare compose (ops/docker/compose.env.example).
FINET_COMPOSE_ENV=/srv/finet/compose/compose.env
# Canalul de notificări (ops/notify/notify.env.example).
FINET_NOTIFY_ENV=/srv/finet/env/notify.env
# Starea (ultima reușită, ultima alertă, blocarea), root 700.
FINET_BACKUP_STATE_DIR=/srv/finet/backup-state
# Anti-flood: aceeași eroare cel mult o dată pe atâtea secunde.
FINET_BACKUP_ALERT_INTERVAL=3600
# Mesajul de succes săptămânal: ziua (1-7, 7 = duminică; 0 = niciodată).
FINET_BACKUP_WEEKLY_OK_DAY=7
# Durata maximă a unei rulări.
FINET_BACKUP_TIMEOUT=3h
