# FINET — variabile de mediu (doar nume, scop și valori FICTIVE).
# Copiază în `.env.local` pentru dezvoltare. În producție valorile reale stau doar pe server,
# niciodată în repository. Lista completă: docs/GHID_CONSTRUIRE.md, secțiunea 10.
# Validarea (tipuri, obligativitate, valori implicite): src/lib/config.ts. O valoare invalidă
# oprește aplicația la pornire; mesajul numește variabila, nu valoarea.
# Un șir gol (`VAR=`) e tratat ca nesetat.
#
# Marcaj: liniile precedate de `# secret` sunt secrete. Scriptul
# scripts/scan-client-secrets.mjs caută numele lor în fișierele trimise browserului (.next/static).
# Variabilele NEXT_PUBLIC_* sunt publice prin definiție: niciun secret în ele.
#
# Secretele ca fișiere: fiecare variabilă secretă validată de src/lib/config.ts acceptă și
# `<NUME>_FILE=<cale>` (de exemplu DATABASE_URL_FILE=/run/secrets/finet_database_url), citit o
# singură dată la pornire. Așa primesc secretele containerele de producție (Docker `secrets:`,
# docs/INFRA.md), ca valorile să nu ajungă în configurația containerului. Reguli: `X` și
# `X_FILE` împreună = eroare; fișier obișnuit (symlink spre fișier permis), cel mult 4096
# octeți, o singură linie; se taie un singur sfârșit de linie final; fișierul gol = eroare.
# Pentru dezvoltare, valoarea directă (`X=...`) rămâne varianta simplă.

# Modul de rulare: personal | saas (obligatorie, fără valoare implicită)
APP_MODE=personal
# Adresa publică a aplicației (opțională, http/https)
APP_URL=http://localhost:3000
# Numele afișat (public; implicit FINET)
NEXT_PUBLIC_APP_NAME=FINET

# Rolul procesului: web | worker | migrate | admin (implicit web; `admin` = CLI-ul de
# administrare, cu DATABASE_URL, de exemplu `FINET_ROLE=admin pnpm admin:create-user ...`).
# Fiecare rol primește DOAR URL-ul lui de bază de date; URL-ul altui rol prezent în mediu
# oprește pornirea (src/lib/config.ts).
# Serverul Next.js (`pnpm dev`, `pnpm start`) e mereu `web`.
# FINET_ROLE=web

# Baza de date (dezvoltare: Postgres local din .devcontainer; producție: Supabase).
# Opțională în Faza 0: fără DATABASE_URL, /api/health raportează `db: unknown`.
# secret
DATABASE_URL=postgres://finet:finet_dev@localhost:5432/finet_dev
# Sau din fișier (nu împreună cu DATABASE_URL):
# DATABASE_URL_FILE=/run/secrets/finet_database_url
# Doar pentru FINET_ROLE=worker (Faza 5/6) și FINET_ROLE=migrate (Faza 1+). NU le pune în
# .env.local: serverul web nu pornește dacă le vede. Se dau doar comenzii care le folosește.
# secret
# WORKER_DATABASE_URL=postgres://finet:finet_dev@localhost:5432/finet_dev
# secret
# MIGRATOR_DATABASE_URL=postgres://finet:finet_dev@localhost:5432/finet_dev
# Variantele din fișier urmează aceeași regulă pe rol (web refuză și `_FILE`-urile lor):
# WORKER_DATABASE_URL_FILE=/run/secrets/finet_worker_database_url
# MIGRATOR_DATABASE_URL_FILE=/run/secrets/finet_migrate_database_url
# Workerul (FINET_ROLE=worker) cere MEREU sslmode=verify-full + DATABASE_CA_FILE (ADR 0011). Doar
# pentru un Postgres local/de test fără TLS: FINET_ALLOW_INSECURE_DB=1 (refuzată în producție).
# FINET_ALLOW_INSECURE_DB=1

# TLS spre bază (Supabase): `sslmode=verify-full` în URL + calea CA-ului (PEM, public, cel mult
# 64 KiB), citit o dată la pornire. Clientul (src/lib/db-client.ts) acceptă atunci DOAR
# certificatele semnate de acest CA. Reguli: CA-ul cere `sslmode=verify-full` sau `verify-ca`
# (altfel pornirea e refuzată); `sslrootcert` în URL e refuzat (postgres.js nu-l citește).
# Fără DATABASE_CA_FILE, `verify-full` folosește CA-urile Node (+ NODE_EXTRA_CA_CERTS);
# `sslmode=require` criptează, dar NU verifică certificatul. Dezvoltare/CI: fără TLS.
# DATABASE_CA_FILE=/run/finet/ca/prod-ca-2021.crt

# Fișiere: local sau s3 (Supabase Storage; driverul S3 vine în Faza 6, până atunci aruncă
# NotImplementedError). Implicit: local.
STORAGE_DRIVER=local
# Director local (fișierele cu driverul local și fișierele temporare). Implicit
# ./.data/storage; în producție (NODE_ENV=production) e obligatoriu.
STORAGE_DIR=./.data/storage
# Cota de stocare în MB (întreg; implicit 5000)
STORAGE_QUOTA_MB=5000
# Obligatorii doar cu STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=https://exemplu.invalid/storage/v1/s3
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_BUCKET=finet-exemplu
# secret
STORAGE_S3_ACCESS_KEY_ID=exemplu-cheie-acces
# secret
STORAGE_S3_SECRET_ACCESS_KEY=exemplu-cheie-secreta
# Sau: STORAGE_S3_ACCESS_KEY_ID_FILE=..., STORAGE_S3_SECRET_ACCESS_KEY_FILE=...

# Cloudflare Access (verificarea JWT-ului `Cf-Access-Jwt-Assertion` în src/proxy.ts).
# CF_ACCESS_REQUIRED: true | false. Implicit true când NODE_ENV=production, altfel false
# (deci în dezvoltare nu trebuie setată). În producție, valoarea false e REFUZATĂ.
# AVERTISMENT: nu copia `false` într-un fișier de mediu de server; `false` dezactivează
# verificarea JWT Cloudflare Access (permis doar în dezvoltare, pe localhost).
# CF_ACCESS_REQUIRED=false
# Obligatorii când CF_ACCESS_REQUIRED=true. Domeniul echipei, fără https:// și fără cale.
CF_ACCESS_TEAM_DOMAIN=echipa-exemplu.cloudflareaccess.com
CF_ACCESS_AUD=exemplu-aud-tag

# Token intern opțional (minim 32 de caractere) pentru /api/health detaliat fără JWT Access,
# trimis în antetul `X-Finet-Health-Token` (monitorizare din rețeaua internă).
# Generare: openssl rand -hex 32. Healthcheck-ul Docker NU are nevoie de el (/api/health/live).
# secret
HEALTH_TOKEN=
# Sau din fișier (producție): HEALTH_TOKEN_FILE=/run/secrets/finet_health_token

# Limite tehnice (Faza 6). Documente procesate cu AI pe zi, per gospodărie (implicit 50).
AI_DAILY_DOCUMENT_LIMIT=50
# Bugetul lunar global pentru furnizori AI externi: SUMĂ în unitatea monedei (ex. 12,50 sau
# 12.50; max. 2 zecimale), convertită intern în unități minore (bigint). 0 = fără AI extern.
AI_MONTHLY_BUDGET=0
# Moneda bugetului: RON | EUR | USD (implicit USD)
AI_MONTHLY_BUDGET_CURRENCY=USD

# Notificări operaționale (Telegram sau SMTP). Opționale; Telegram cere ambele variabile.
# Pe server, notificările sunt ale hostului (ops/notify/notify.sh, /srv/finet/env/notify.env),
# nu ale containerelor. În aplicație: NOTIFY_TELEGRAM_BOT_TOKEN_FILE, SMTP_PASSWORD_FILE.
# secret
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# Destinatarul alertelor pe email (doar ops/notify/notify.sh; nevalidat de src/lib/config.ts).
# Canalul email cere SMTP_HOST, SMTP_FROM și NOTIFY_EMAIL_TO. Nicio valoare de notificare nu
# poate conține LF/CR (notify.sh refuză valoarea, cod 2).
NOTIFY_EMAIL_TO=

# Autentificare (Better Auth, F1-B; ADR 0003). Secretul semnează cookie-urile și tokenurile
# bearer: minimum 32 de caractere, obligatoriu pentru serverul web în producție. Valoarea de mai
# jos e intenționat INVALIDĂ și e refuzată la pornire: generează una reală cu
# `openssl rand -base64 32`. Producție: BETTER_AUTH_SECRET_FILE=/run/secrets/finet_better_auth_secret
# (doar finet-web îl primește). În producție APP_URL e obligatorie și trebuie să fie https://.
# secret
BETTER_AUTH_SECRET=INVALID-inlocuieste-ma-nu-e-un-secret
# Verificarea parolelor compromise (HIBP, k-anonymity: pleacă doar 5 caractere din SHA-1).
# true | false, implicit false (fără apeluri externe).
# AUTH_HIBP_ENABLED=false
# Rate limiting (stocat în finet.auth_rate_limits; cheia = IP de încredere + email normalizat).
# Întregi ≥ 1; valorile implicite sunt cele de mai jos.
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_MOBILE_LOGIN_MAX_ATTEMPTS=10
# AUTH_MOBILE_LOGIN_WINDOW_SECONDS=900
# Plafonul pe email singur (fără IP), în plus față de limita pe IP + email: numără DOAR
# login-urile eșuate și se resetează după un login reușit; un IP de încredere cu login reușit
# pentru acel email în ultimele 30 de zile nu e blocat de el. Login-ul mobil are găleată proprie
# doar cu IP de încredere (Access verificat).
# AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=20
# AUTH_LOGIN_EMAIL_WINDOW_SECONDS=3600
# AUTH_EMAIL_MAX_REQUESTS=3
# AUTH_EMAIL_WINDOW_SECONDS=3600
# AUTH_PASSWORD_CHANGE_MAX_ATTEMPTS=5
# AUTH_PASSWORD_CHANGE_WINDOW_SECONDS=900

# Email (opțional în `personal`; folosit și pentru notificări). Dacă SMTP_HOST e setat,
# SMTP_FROM e obligatoriu. Port implicit 587 (STARTTLS obligatoriu; 465 = TLS implicit).
# Fără SMTP_HOST, magic link-ul și resetarea parolei prin email sunt DEZACTIVATE; resetarea se
# face din CLI (`pnpm admin:reset-password`).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
# secret
SMTP_PASSWORD=
SMTP_FROM=FINET <finet@exemplu.invalid>

# Backup-ul (F3-D, docs/BACKUP.md): NU sunt variabile ale aplicației. Le folosește doar imaginea
# de backup (serviciul finet-backup), și numai ca fișiere: RESTIC_PASSWORD_FILE,
# AWS_ACCESS_KEY_ID_FILE, AWS_SECRET_ACCESS_KEY_FILE, PGSERVICEFILE (fișier de servicii libpq cu
# parola rolului finet_backup) și, pentru destinația rclone (Google Drive), RCLONE_CONFIG = calea
# fișierului-secret finet_rclone_conf (tokenul OAuth; nu e o variabilă cu valoare secretă, ci o
# cale). Marcate aici ca secrete ca verificările (ops/docker/
# test-env-examples.sh, scan:client-secrets) să le refuze în clar.
# secret
# RESTIC_PASSWORD=
# secret
# AWS_ACCESS_KEY_ID=
# secret
# AWS_SECRET_ACCESS_KEY=
