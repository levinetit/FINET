{
  "name": "finet",
  "version": "0.0.0",
  "private": true,
  "description": "FINET — finanțe personale și de familie pentru România",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.7 <25",
    "pnpm": ">=12.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:tools": "node scripts/build-tools.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ops": "sh ops/notify/test.sh && sh ops/docker/test-env-examples.sh && sh ops/backup/test.sh",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "scan:client-secrets": "node scripts/scan-client-secrets.mjs .next/static",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "fixtures:receipts": "node scripts/make-receipt-fixtures.mjs",
    "eval:receipts": "vitest run --config vitest.eval.config.mts",
    "openapi:generate": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build:tools && node dist/tools/migrate.mjs",
    "admin:create-user": "pnpm build:tools && node dist/tools/admin.mjs create-user",
    "admin:reset-password": "pnpm build:tools && node dist/tools/admin.mjs reset-password",
    "admin:add-member": "pnpm build:tools && node dist/tools/admin.mjs add-member",
    "admin:cleanup-idempotency": "pnpm build:tools && node dist/tools/admin.mjs cleanup-idempotency"
  },
  "dependencies": {
    "better-auth": "1.7.13",
    "busboy": "1.6.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg-boss": "12.38.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/busboy": "1.5.5",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
